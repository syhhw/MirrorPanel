# Builds and generated output (recreated from the source)
/build/
/dist/
/installer_output/
*.spec

# Local data left by the 1.x app (not part of the code). Recordings and
# screenshots now go to the user's "Videos\MirrorPanel Media", outside the
# project folder; the old folder names stay ignored in case an older
# install left something behind.
/logs/
/recordings/
/screenshots/
settings.json
installer_language.marker

# Python
__pycache__/
*.pyc

# Editor/OS
.vscode/
Thumbs.db

# Third-party binaries used by the 1.x app (scrcpy/adb). Download them from
# each project's official source; there is no point re-hosting tens of MB of
# DLLs here.
/bin/

# Local trail query caches
/graft/
/.trail/cache/

# Local state of AI tools and personal automation (not project code)
/.Codex/
/.claude/
/.claude-flow/
/.swarm/
/.ruff_cache/
/handoff.cmd
/instalar_hook.bat

# Loose screenshots
/Prints/
