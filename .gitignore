# Builds e saidas geradas (recriaveis a partir do codigo-fonte)
/build/
/dist/
/installer_output/
*.spec

# Dados locais de uso (nao fazem parte do codigo)
# Gravacoes/capturas de tela novas ficam em "Videos\MirrorPanel Media" do
# usuario, fora da pasta do projeto - mas ainda ignora os nomes antigos aqui
# tambem, caso sobre algo de uma instalacao anterior.
/logs/
/recordings/
/screenshots/
settings.json
installer_language.marker

# Python
__pycache__/
*.pyc

# Editor/SO
.vscode/
Thumbs.db

# Binarios de terceiros (scrcpy/adb) - baixe do repositorio oficial de cada um,
# nao faz sentido re-hospedar aqui (e sao dezenas de MB de DLLs)
/bin/

# Caches locais de consulta trail
/graft/
/.trail/cache/

# Estado local de ferramentas de IA e automacoes pessoais (nao e codigo do projeto)
/.Codex/
/.claude/
/.claude-flow/
/.swarm/
/.ruff_cache/
/handoff.cmd
/instalar_hook.bat

# Capturas avulsas de tela
/Prints/
