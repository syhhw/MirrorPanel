<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mirrorpanel.companion" android:versionCode="4" android:versionName="2.0.0-preview.4">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:label="MirrorPanel Companion" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <activity android:name=".AudioConsentActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
    <service android:name=".MirrorInput" android:label="MirrorPanel" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
      <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
    </service>
    <service android:name=".SessionService" android:exported="false" android:foregroundServiceType="specialUse|mediaProjection">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Visible connection indicator for an authorized USB screen mirroring session" />
    </service>
  </application>
</manifest>
