{
  "name": "mirrorpanel-native",
  "version": "2.0.0-preview.5",
  "private": true,
  "description": "MirrorPanel original Android mirroring engine",
  "license": "Apache-2.0",
  "main": "build/desktop/main.cjs",
  "scripts": {
    "android": "python scripts/build-android.py",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "test:android": "python scripts/test-android.py"
  },
  "dependencies": {
    "mp4-muxer": "5.2.2"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "typescript": "5.9.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@types/dom-webcodecs": "^0.1.16",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  }
}
