# Text is stored with LF in the repository; each machine picks the line
# endings of its working copy. Windows scripts always use CRLF.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ico binary
*.apk binary
*.jar binary
*.exe binary
*.dll binary
